{
  "appId": "com.sdxinspect.app",
  "appName": "SDX Inspect",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "*.googleapis.com",
      "*.gstatic.com",
      "*.firebaseapp.com",
      "*.firebasestorage.app",
      "firestore.googleapis.com",
      "identitytoolkit.googleapis.com",
      "securetoken.googleapis.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16152E",
    "scheme": "SDXInspect"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2A295C",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "none"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#16152E",
      "style": "DARK"
    }
  }
}